
# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Secrets and environment variables
.env
.env.*
!.env.example

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

