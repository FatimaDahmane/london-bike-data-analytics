# Raw input data
data/raw/*

# Processed and rejected datasets
data/processed/*
data/rejected/*

# Preserve directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/rejected/.gitkeep

data/*.duckdb
data/*.duckdb.wal
